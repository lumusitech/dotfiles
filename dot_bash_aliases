# ------------------------------------------------------------------------------
# 4. DESARROLLO Y PUERTOS
# ------------------------------------------------------------------------------
myport() {
  sudo ss -tulpn | grep ":$1 "
}

alias killnode='pkill -f node'

# Consultar alias rápidamente (ejemplo: "als git", "als docker" o "als")
als() {
  if [[ -n "$1" ]]; then
    alias | grep -i "$1" | sed "s/alias //"
  else
    alias | sed "s/alias //"
  fi
}

# ------------------------------------------------------------------------------
# 5. DOTFILES & CHEZMOI (Flujo Seguro con Ramas y PRs)
# ------------------------------------------------------------------------------
alias cz='chezmoi'
alias czdiff='chezmoi diff'
alias czst='chezmoi status'
alias czre='chezmoi re-add'
alias czcd='chezmoi cd'
alias czup='chezmoi update'

# Crear rama auxiliar para cambios
czbranch() {
  git -C ~/.local/share/chezmoi checkout -b "$1"
}

# Guardar cambios y subir la rama a GitHub
czpush() {
  local current_branch
  current_branch=$(git -C ~/.local/share/chezmoi branch --show-current)
  if [ "$current_branch" = "main" ]; then
    echo "❌ Error: La rama 'main' está protegida en GitHub. Crea una rama con 'czbranch <nombre>' antes de pushear."
    return 1
  fi
  chezmoi re-add
  git -C ~/.local/share/chezmoi add .
  git -C ~/.local/share/chezmoi commit -v
  git -C ~/.local/share/chezmoi push -u origin "$current_branch"
}

# Abrir PR en GitHub Web
alias czpr='env -u GITHUB_TOKEN gh pr create --repo lumusitech/dotfiles --web'

# Volver a main, sincronizar, auto-eliminar la rama local del PR y aplicar dotfiles
unalias czmain 2>/dev/null
czmain() {
  local repo="$HOME/.local/share/chezmoi"
  local prev_branch
  prev_branch=$(git -C "$repo" branch --show-current)

  # 1. Volver a main
  git -C "$repo" checkout main || return 1

  # 2. Sincronizar main y podar referencias remotas que GitHub ya borró
  git -C "$repo" pull --prune || return 1

  # 3. Borrar la rama auxiliar local de la que venías (evita tener que borrarla a mano)
  if [[ -n "$prev_branch" && "$prev_branch" != "main" ]]; then
    git -C "$repo" branch -D "$prev_branch" 2>/dev/null && \
      echo "🧹 Rama local '$prev_branch' eliminada automáticamente."
  fi

  # 4. Limpieza preventiva: borrar ramas locales huérfanas viejas [gone]
  git -C "$repo" for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | \
    awk '$2 == "[gone]" {print $1}' | while read -r gone_branch; do
      [[ -n "$gone_branch" && "$gone_branch" != "main" ]] && \
        git -C "$repo" branch -D "$gone_branch" 2>/dev/null && \
        echo "🧹 Rama huérfana vieja '$gone_branch' eliminada."
    done

  # 5. Aplicar dotfiles
  chezmoi apply
}

