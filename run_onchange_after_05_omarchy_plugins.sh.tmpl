#!/usr/bin/env bash
# Sincronización y aprovisionamiento de plugins de Omarchy Shell (Quickshell)
# hash: {{ include "dot_config/omarchy/private_shell.json" | sha256sum }}

set -euo pipefail

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
mkdir -p "$PLUGINS_DIR"

declare -A PLUGINS=(
  ["agx.screen-time"]="https://github.com/ax1g/quickshell-screentime-plugin.git"
  ["bobbynicholas.omaland"]="https://github.com/bobby-nicholas/omaland.git"
  ["io.github.x3me.nexthop"]="https://github.com/x3me/omarchy-nexthop.git"
  ["omaconnect"]="https://github.com/jitendradara12/omaconnect.git"
  ["omamail"]="https://github.com/huacnlee/omamail.git"
)

for id in "${!PLUGINS[@]}"; do
  url="${PLUGINS[$id]}"
  target="$PLUGINS_DIR/$id"
  if [ ! -d "$target" ]; then
    echo "📦 Clonando plugin de Omarchy: $id..."
    git clone --depth 1 "$url" "$target" 2>/dev/null || true
  fi
done

# Parche de resiliencia para el sandbox de Omarchy 4 en Omaland
OMALAND_SERVICE="$PLUGINS_DIR/bobbynicholas.omaland/Service.qml"
if [ -f "$OMALAND_SERVICE" ]; then
  if ! grep -q "plugins/bobbynicholas.omaland" "$OMALAND_SERVICE"; then
    sed -i 's|var dir = manifest && manifest.__sourceDir|var dir = (manifest \&\& manifest.__sourceDir) \|\| (Quickshell.env("HOME") + "/.config/omarchy/plugins/bobbynicholas.omaland")|' "$OMALAND_SERVICE" || true
  fi
fi

# Parches de resiliencia para OmaConnect
OMACONNECT_DEVICE_SECTION="$PLUGINS_DIR/omaconnect/components/DeviceSection.qml"
if [ -f "$OMACONNECT_DEVICE_SECTION" ]; then
  sed -i 's|text: "Verify on both devices: " + (root\.service ? root\.service\.formatVerificationKey(panel\.incomingRequest\.verificationKey) : panel\.incomingRequest\.verificationKey)|text: (panel.incomingRequest \&\& panel.incomingRequest.verificationKey) ? "Verify on both devices: " + (root.service ? root.service.formatVerificationKey(panel.incomingRequest.verificationKey) : panel.incomingRequest.verificationKey) : ""|' "$OMACONNECT_DEVICE_SECTION" 2>/dev/null || true
fi

OMACONNECT_CONTROLLER="$PLUGINS_DIR/omaconnect/KdeConnectController.qml"
if [ -f "$OMACONNECT_CONTROLLER" ]; then
  python3 -c '
from pathlib import Path
p = Path("'$OMACONNECT_CONTROLLER'")
if p.exists():
    c = p.read_text()
    old = """if (value.indexOf("device") !== -1 || value.indexOf("chargeChanged") !== -1 || value.indexOf("stateChanged") !== -1 || value.indexOf("refreshed") !== -1)
                dbusDebounceTimer.restart()
            if (value.indexOf("mpris") !== -1 || value.indexOf("PropertiesChanged") !== -1)
                mediaDebounceTimer.restart()"""
    new = """if (value.indexOf("mpris") !== -1 || value.indexOf("propertiesChanged") !== -1 || value.indexOf("PropertiesChanged") !== -1) {
                mediaDebounceTimer.restart()
            } else if (/(deviceAdded|deviceRemoved|deviceVisibilityChanged|deviceListChanged|reachableChanged|pairedChanged|nameChanged|typeChanged|chargeChanged|stateChanged)/.test(value)) {
                dbusDebounceTimer.restart()
            }"""
    if old in c:
        p.write_text(c.replace(old, new))
' 2>/dev/null || true
fi

# Actualizar base de datos de aplicaciones de escritorio y refrescar Omarchy Shell
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "$HOME/.local/share/applications/" 2>/dev/null || true
fi

if command -v omarchy-shell >/dev/null 2>&1; then
  omarchy-shell shell rescanPlugins 2>/dev/null || true
fi

if command -v omarchy >/dev/null 2>&1; then
  omarchy menu refresh 2>/dev/null || true
fi
