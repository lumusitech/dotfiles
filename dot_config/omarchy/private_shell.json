          ],
          "hidden": []
        },
        {
          "id": "agx.screen-time"
        },
        {
          "id": "omamail"
        },
        {
          "id": "io.github.x3me.nexthop"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
