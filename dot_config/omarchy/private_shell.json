        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.media"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.tray",
