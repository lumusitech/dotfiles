#!/usr/bin/env bash
TARGET="$1"

if [[ -f "$TARGET" ]]; then
  # Extrae la URL del archivo .link.html
  URL=$(grep -oP 'https://docs\.google\.com/[^"'\'' ]+' "$TARGET" | head -n 1)
  
  if [[ -n "$URL" ]]; then
    exec launch-webapp "$URL"
  fi
fi

# Fallback si se abre sin archivo
exec launch-webapp "${TARGET:-https://drive.google.com}"

