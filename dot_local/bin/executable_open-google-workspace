#!/usr/bin/env bash
TARGET="$1"

if [[ -f "$TARGET" ]]; then
  # Extrae la URL del archivo .link.html
  URL=$(grep -oP 'https://docs\.google\.com/[^"'\'' ]+' "$TARGET" | head -n 1)
  
  if [[ -n "$URL" ]]; then
    # Deriva a la WebApp correspondiente según la URL
    if [[ "$URL" == *"spreadsheets"* ]]; then
      exec omarchy-launch-webapp "$URL"
    elif [[ "$URL" == *"document"* ]]; then
      exec omarchy-launch-webapp "$URL"
    elif [[ "$URL" == *"presentation"* ]]; then
      exec omarchy-launch-webapp "$URL"
    else
      exec omarchy-launch-webapp "$URL"
    fi
  fi
fi

# Fallback si se abre sin archivo
exec omarchy-launch-webapp "${TARGET:-https://drive.google.com}"
