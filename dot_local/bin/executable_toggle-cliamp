#!/usr/bin/env bash
if hyprctl clients | grep -B 15 "class: cliamp-scratchpad" | grep -q "workspace:.*special:cliamp"; then
    hyprctl dispatch togglespecialworkspace cliamp
else
    if ! hyprctl monitors | grep -q "special:cliamp"; then
        hyprctl dispatch togglespecialworkspace cliamp
    fi
    hyprctl dispatch exec "foot --app-id=cliamp-scratchpad --title=Cliamp -e cliamp"
fi
