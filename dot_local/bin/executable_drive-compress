cat << 'EOF' > ~/.local/bin/drive-compress
#!/usr/bin/env bash
set -eo pipefail

if [ -z "$1" ]; then
    echo "Uso: drive-compress <archivo_de_video> [carpeta_destino]"
    exit 1
fi

INPUT_FILE="$1"
DEST_FOLDER="${2:-Videos/Comprimidos}"
BASENAME=$(basename -- "$INPUT_FILE")
FILENAME="${BASENAME%.*}"
OUTPUT_FILE="/tmp/${FILENAME}_720p.mp4"

# Selección de cuenta de destino
REMOTES=("drive-lumusika" "drive-abc" "drive-carludev" "drive-lumusitech")

echo "=========================================="
echo "      COMPRESIÓN Y SUBIDA A DRIVE         "
echo "=========================================="
echo "Seleccioná la cuenta de Google Drive:"
for i in "${!REMOTES[@]}"; do
    printf "  [%d] %s\n" "$((i+1))" "${REMOTES[$i]}"
done

read -rp "Opción [1-${#REMOTES[@]}] (Default 1): " CHOICE
CHOICE=${CHOICE:-1}
SELECTED_REMOTE="${REMOTES[$((CHOICE-1))]}"

if [ -z "$SELECTED_REMOTE" ]; then
    echo "Opción inválida. Abortando."
    exit 1
fi

echo -e "\n[1/2] Comprimiendo '$INPUT_FILE' usando VA-API (AMD)..."
ffmpeg -vaapi_device /dev/dri/renderD128 -i "$INPUT_FILE" \
    -vf 'format=nv12,hwupload,scale_vaapi=w=-2:h=720' \
    -c:v h264_vaapi -b:v 1500k -maxrate 2000k -bufsize 3000k \
    -c:a aac -b:a 128k \
    -movflags +faststart \
    -y "$OUTPUT_FILE"

echo -e "\n[2/2] Subiendo a '$SELECTED_REMOTE:$DEST_FOLDER'..."
rclone copy --progress "$OUTPUT_FILE" "$SELECTED_REMOTE:$DEST_FOLDER"

# Limpiar archivo temporal
rm -f "$OUTPUT_FILE"

echo -e "\n✔ Proceso completado exitosamente en $SELECTED_REMOTE:$DEST_FOLDER."
EOF
