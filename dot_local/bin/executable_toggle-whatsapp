#!/usr/bin/env bash
if hyprctl clients | grep -B 15 "class: chrome-web.whatsapp.com__-Default" | grep -q "workspace:.*special:whatsapp"; then
    hyprctl dispatch togglespecialworkspace whatsapp
else
    if ! hyprctl monitors | grep -q "special:whatsapp"; then
        hyprctl dispatch togglespecialworkspace whatsapp
    fi
    hyprctl dispatch exec "$HOME/.local/bin/launch-webapp https://web.whatsapp.com/"
fi
