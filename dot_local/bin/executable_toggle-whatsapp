#!/usr/bin/env bash
if hyprctl clients | grep -B 15 "class: chrome-web.whatsapp.com__-Default" | grep -q "workspace:.*special:whatsapp"; then
    hyprctl dispatch 'hl.dsp.workspace.toggle_special("whatsapp")'
else
    if ! hyprctl monitors | grep -q "special:whatsapp"; then
        hyprctl dispatch 'hl.dsp.workspace.toggle_special("whatsapp")'
    fi
    hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-launch-webapp https://web.whatsapp.com/")'
fi
