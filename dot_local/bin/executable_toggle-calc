#!/usr/bin/env bash
if hyprctl clients | grep -B 15 -iE "(class:.*calc|title:.*calc)" | grep -q "workspace:.*special:calc"; then
    hyprctl dispatch togglespecialworkspace calc
else
    if ! hyprctl monitors | grep -q "special:calc"; then
        hyprctl dispatch togglespecialworkspace calc
    fi
    CALC_CMD="galculator"
    for c in omacalc kcalc galculator gnome-calculator; do
        if command -v "$c" >/dev/null 2>&1; then
            CALC_CMD="$c"
            break
        fi
    done
    hyprctl dispatch exec "$CALC_CMD"
fi
