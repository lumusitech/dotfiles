#!/usr/bin/env bash
if hyprctl clients | grep -B 15 -iE "(class:.*omacalc|title:.*omacalc)" | grep -q "workspace:.*special:calc"; then
    hyprctl dispatch 'hl.dsp.workspace.toggle_special("calc")'
else
    if ! hyprctl monitors | grep -q "special:calc"; then
        hyprctl dispatch 'hl.dsp.workspace.toggle_special("calc")'
    fi
    hyprctl dispatch 'hl.dsp.exec_cmd("omacalc")'
fi
