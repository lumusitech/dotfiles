#!/usr/bin/env bash
# ==============================================================================
# launch-webapp - Lanzador universal de aplicaciones web en modo standalone
# Compatible con CachyOS, Arch Linux, Hyprland y navegadores basados en Chromium / Gecko
# ==============================================================================

set -euo pipefail

URL="${1:-https://google.com}"
shift || true

# 1. Determinar el navegador
BROWSER_CMD=""

DEFAULT_DESKTOP=$(xdg-settings get default-web-browser 2>/dev/null || echo "")
if [[ -n "$DEFAULT_DESKTOP" ]]; then
  for dir in "$HOME/.local/share/applications" "$HOME/.nix-profile/share/applications" "/usr/local/share/applications" "/usr/share/applications"; do
    if [[ -f "$dir/$DEFAULT_DESKTOP" ]]; then
      EXEC_BIN=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$dir/$DEFAULT_DESKTOP" | head -n1)
      if command -v "$EXEC_BIN" >/dev/null 2>&1; then
        BROWSER_CMD="$EXEC_BIN"
        break
      fi
    fi
  done
fi

if [[ -z "$BROWSER_CMD" ]]; then
  for candidate in google-chrome-stable google-chrome brave-bin brave chromium cachy-browser firefox microsoft-edge-stable; do
    if command -v "$candidate" >/dev/null 2>&1; then
      BROWSER_CMD="$candidate"
      break
    fi
  done
fi

if [[ -z "$BROWSER_CMD" ]]; then
  exec xdg-open "$URL"
fi

# 2. Configurar flags según el motor de renderizado
BROWSER_BASE=$(basename "$BROWSER_CMD")
ARGS=()

case "$BROWSER_BASE" in
  *chrome*|*brave*|*chromium*|*edge*|*opera*|*vivaldi*)
    ARGS=("--app=$URL")
    ;;
  *cachy-browser*|*firefox*|*zen*|*librewolf*)
    ARGS=("--new-window" "$URL")
    ;;
  *)
    ARGS=("$URL")
    ;;
esac

# 3. Lanzar desacoplado con uwsm si está presente o setsid
if command -v uwsm-app >/dev/null 2>&1; then
  exec setsid uwsm-app -- "$BROWSER_CMD" "${ARGS[@]}" "$@"
elif command -v uwsm >/dev/null 2>&1; then
  exec setsid uwsm app -- "$BROWSER_CMD" "${ARGS[@]}" "$@"
else
  exec setsid "$BROWSER_CMD" "${ARGS[@]}" "$@" >/dev/null 2>&1
fi
