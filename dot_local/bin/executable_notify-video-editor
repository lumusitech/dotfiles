#!/usr/bin/env bash
set -euo pipefail

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

while [ ! -S "$SOCKET" ]; do
  sleep 1
done

socat -U - "UNIX-CONNECT:$SOCKET" | while read -r line; do
  case "$line" in
    openwindow*kdenlive*|openwindow*org.kde.kdenlive*|openwindow*omacut*|openwindow*obs*|openwindow*shotcut*)
      notify-send \
        --app-name="Video Studio" \
        --icon="video-x-generic" \
        "Comando: drive-compress [nombre].mp4" \
        "Reduce el tamaño con VA-API en RX 7600 para subir a Google Drive y compartir."
      ;;
  esac
done
