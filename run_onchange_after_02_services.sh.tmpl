#!/usr/bin/env bash
# Recarga de unidades de systemd para montajes de rclone y daemon de voxtype
# hash: {{ include "dot_config/systemd/user/rclone-mount@.service" | sha256sum }}
# hash: {{ include "dot_config/systemd/user/voxtype.service" | sha256sum }}

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload
  mkdir -p "$HOME/Drive/lumusika" "$HOME/Drive/abc" "$HOME/Drive/carludev" "$HOME/Drive/lumusitech"
  systemctl --user enable --now rclone-mount@lumusika rclone-mount@abc rclone-mount@carludev rclone-mount@lumusitech 2>/dev/null || true
  if command -v voxtype >/dev/null 2>&1; then
    systemctl --user enable --now voxtype.service 2>/dev/null || true
  fi
fi
