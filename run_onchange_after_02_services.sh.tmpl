#!/usr/bin/env bash
# Recarga de unidades de systemd para montajes de Google Drive, OneDrive, Voxtype y notificaciones
# hash: {{ include "dot_config/systemd/user/rclone-mount@.service" | sha256sum }}
# hash: {{ include "dot_config/systemd/user/onedrive-mount@.service" | sha256sum }}
# hash: {{ include "dot_config/systemd/user/voxtype.service" | sha256sum }}
# hash: {{ include "dot_config/systemd/user/notify-video-editor.service" | sha256sum }}

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload

  # Google Drive (Rclone)
  mkdir -p "$HOME/Drive/lumusika" "$HOME/Drive/abc" "$HOME/Drive/carludev" "$HOME/Drive/lumusitech"
  systemctl --user enable --now rclone-mount@lumusika rclone-mount@abc rclone-mount@carludev rclone-mount@lumusitech 2>/dev/null || true

  # OneDrive (Rclone)
  mkdir -p "$HOME/OneDrive/lumusitec" "$HOME/OneDrive/carludev"
  systemctl --user enable --now onedrive-mount@lumusitec onedrive-mount@carludev 2>/dev/null || true

  # Voxtype
  if command -v voxtype >/dev/null 2>&1; then
    systemctl --user enable --now voxtype.service 2>/dev/null || true
  fi

  # Notify Video Editor
  if [ -f "$HOME/.local/bin/notify-video-editor" ]; then
    systemctl --user enable --now notify-video-editor.service 2>/dev/null || true
  fi
fi
