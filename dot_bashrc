# If not running interactively, don't do anything else
[[ $- != *i* ]] && return

# ble.sh syntax highlighting & autosuggestions (si está instalado)
[[ -f ~/.local/share/blesh/ble.sh ]] && source ~/.local/share/blesh/ble.sh --noattach

# Variables de entorno de binarios y cargo (si existen)
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# pnpm
export PNPM_HOME="/home/carludev/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# FZF keybindings y autocompletado
command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"

# Cargar aliases personalizados
[[ -f ~/.bash_aliases ]] && source ~/.bash_aliases

# ble.sh attach (debe ejecutarse al final)
[[ ${BLE_VERSION-} ]] && ble-attach


# Added by Antigravity CLI installer
export PATH="/home/carludev/.local/bin:$PATH"

# >>> lumusitech agent env >>>
# Load ~/.agent/.env credentials (GITHUB_TOKEN, MEMORY_FILE_PATH, etc.) for opencode MCP servers
if [ -f "$HOME/.agent/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    source "$HOME/.agent/.env"
    set +a
fi
# <<< lumusitech agent env <<<

# Added by LM Studio CLI (lms)
export PATH="$PATH:/home/carludev/.lmstudio/bin"
# End of LM Studio CLI section



# Load Angular CLI autocompletion (si está instalado).
command -v ng >/dev/null 2>&1 && source <(ng completion script)

